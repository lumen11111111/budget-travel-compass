{
	"$schema": "node_modules/wrangler/config-schema.json",
"name": "budget-travel-compass",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "budget-travel-compass",
"database_id": "28e229c2-c032-4c09-9490-630c1b88df50"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "budget-travel-compass-media"
		}
	],
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://example.com",
"R2_PUBLIC_BASE_URL": "https://example.com/media"
	}
}
